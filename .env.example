# App
DATABASE_URL=file:./apexvalue.db
# For Turso cloud: DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token  (only needed for Turso cloud)
APP_BASE_URL=http://localhost:3000
MARKETING_BASE_URL=http://localhost:3000
JWT_SECRET=change-me-in-production-min-32-chars
SESSION_SECRET=change-me-in-production-min-32-chars

# Feature Flags
ENABLE_LIVE_MODE=false
ENABLE_STRIPE=false
ENABLE_R2=false

# Cloudflare R2 (optional - set ENABLE_R2=true to activate)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Stripe (optional - set ENABLE_STRIPE=true to activate)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Demo org seeding
SEED_DEMO=true
